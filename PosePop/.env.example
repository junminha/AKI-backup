# 포즈 분석과 이미지 생성 모두 OpenRouter를 씁니다. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen3.6-27b
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# 그림 한 장에 허용할 최대 비용(달러). 이 예산을 넘길 수 있는 provider로는
# 아예 라우팅하지 않으므로, 넘게 되면 그림을 만들지 않고 실패합니다.
OPENROUTER_IMAGE_BUDGET_USD=0.05

# OpenRouter 대시보드에서 앱을 구분하기 위한 선택 값입니다.
OPENROUTER_SITE_URL=https://posepop-rouge.vercel.app
OPENROUTER_APP_NAME=Pose Pop

PORT=8787
