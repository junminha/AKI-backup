# OpenRouter(https://openrouter.ai/keys)에서 발급한 키를 등호 뒤에 붙여 넣으세요.
# 표정 판독에 필요한 유일한 키입니다.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=qwen/qwen3.6-27b

# OpenRouter 대시보드에서 앱을 구분하기 위한 선택 값입니다.
OPENROUTER_SITE_URL=https://facegroq.vercel.app
OPENROUTER_APP_NAME=Expression Lab

PORT=8788

# HTTPS로 실제 배포할 때만 true. 로컬 HTTP에서는 켜지 마세요.
ENABLE_HSTS=false
